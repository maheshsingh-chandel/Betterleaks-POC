#!/bin/sh
set -eu

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "betterleaks is not installed or not on PATH." >&2
  echo "Install it, then retry the commit. See README.md." >&2
  exit 1
fi

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
  exit 0
fi

tmp_dir=$(mktemp -d 2>/dev/null || mktemp -d -t betterleaks-precommit)
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

echo "$staged_files" | while IFS= read -r file; do
  [ -n "$file" ] || continue
  mkdir -p "$tmp_dir/$(dirname "$file")"
  git show ":$file" > "$tmp_dir/$file"
done

echo "Running Betterleaks pre-commit scan on staged files..."
betterleaks dir "$tmp_dir" --config betterleaks.toml --redact --confidence low
